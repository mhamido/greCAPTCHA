OPENROUTER_API_KEY=
# Generation validation is strict by default. Set to false for tolerant local-model testing.
STRICT_MODE=true
# Optional self-hosted OpenAI-compatible API (for example vLLM).
# Use the server root or its /v1 URL; /v1 is added when omitted.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
# Try the local text extractor before sending a PDF to the endpoint.
LOCAL_LLM_FORCE_TEXT=0
# Maximum extracted manuscript characters sent to a text-only local model.
LOCAL_LLM_MAX_DOCUMENT_CHARS=60000
# Seconds before a self-hosted request is abandoned; small local models read long prompts slowly.
LOCAL_LLM_TIMEOUT_SECONDS=600
GEMINI_API_KEY=
DATABASE_URL=./data/research-captcha.db
# Required for any deployment: gates the researcher interface.
# Leave unset for local `next dev` only.
RESEARCHER_PASSWORD=
# Public origin participants reach, e.g. https://rc.example.org
# Used to build participant links; falls back to the browser's own origin.
PUBLIC_BASE_URL=

# Where backups are written. Leave unset to switch backups off entirely.
# Each backup is a timestamped folder holding a consistent snapshot of the
# database, everything else in the database folder, and answers.csv.
BACKUP_DIR=./backups
# How often a backup is taken, in minutes. Default 60.
BACKUP_INTERVAL_MINUTES=60
# How many backups to keep. The oldest beyond this are deleted. Default 48.
BACKUP_KEEP=48
